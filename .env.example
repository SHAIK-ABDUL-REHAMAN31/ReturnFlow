# ==============================================================================
# ReturnFlow - Root Environment Configuration Template
# COPY THIS FILE TO .env IN RESPECTIVE DIRECTORIES (DO NOT COMMIT REAL SECRETS)
# ==============================================================================

# Backend Environment Variables
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/returnflow
JWT_ACCESS_SECRET=change_me_super_secret_jwt_access_token_key_at_least_32_bytes_length
JWT_REFRESH_SECRET=change_me_super_secret_jwt_refresh_token_key_at_least_32_bytes_length
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
S3_BUCKET_NAME=returnflow-returns-bucket
SQS_LABEL_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/returnflow-label-queue
SQS_REFUND_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/returnflow-refund-queue
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:returnflow-notifications
OPENSEARCH_ENDPOINT=https://search-returnflow-demo.us-east-1.es.amazonaws.com

# Frontend Environment Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_CLOUDFRONT_URL=
