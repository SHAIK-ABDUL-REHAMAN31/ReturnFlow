{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:006635110818:function:returnflow-validate-return",
        "arn:aws:lambda:us-east-1:006635110818:function:returnflow-generate-label",
        "arn:aws:lambda:us-east-1:006635110818:function:returnflow-upload-s3",
        "arn:aws:lambda:us-east-1:006635110818:function:returnflow-update-status"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:us-east-1:006635110818:returnflow-notifications"
    }
  ]
}
